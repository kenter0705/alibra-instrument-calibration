DATABASE_URL="file:./dev.db"
APP_HTTPS=false

# Local preview bypasses login. The Windows installer does not include this file,
# so installed packages retain the account login flow.
CALIBRA_PREVIEW_MODE=true
# Optional Google Sign-In credentials from Google Cloud Console OAuth web client.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
